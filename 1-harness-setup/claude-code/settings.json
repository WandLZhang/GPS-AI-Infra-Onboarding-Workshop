{
  "permissions": {
    "defaultMode": "bypassPermissions",
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(date)",
      "Bash(whoami)",
      "Bash(gcp-pricing *)",

      "Read(//tmp/**)",
      "Edit(//tmp/**)",

      "mcp__github-mcp__get_*",
      "mcp__github-mcp__list_*",
      "mcp__github-mcp__search_*",
      "mcp__github-mcp__pull_request_read",
      "mcp__github-mcp__issue_read",
      "mcp__github-mcp__get_me",
      "mcp__google-dev-knowledge__*",
      "mcp__google-cloud-logging__list_*",
      "mcp__google-cloud-logging__get_*"
    ],
    "ask": [
      "Bash(gh pr create *)",
      "Bash(gh pr comment *)",
      "Bash(gh pr review *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(gh pr close *)",
      "Bash(gh pr reopen *)",
      "Bash(gh issue create *)",
      "Bash(gh issue comment *)",
      "Bash(gh issue edit *)",
      "Bash(gh issue close *)",
      "Bash(gh issue reopen *)",
      "Bash(gh release create *)",
      "Bash(gh release edit *)",
      "mcp__github-mcp__add_*",
      "mcp__github-mcp__create_pull_request",
      "mcp__github-mcp__update_pull_request",
      "mcp__github-mcp__merge_pull_request",
      "mcp__github-mcp__pull_request_review_write",
      "mcp__github-mcp__issue_write",
      "mcp__github-mcp__sub_issue_write",
      "mcp__github-mcp__assign_copilot_to_issue",
      "mcp__github-mcp__request_copilot_review"
    ],
    "deny": [],
    "additionalDirectories": ["/tmp"]
  },
  "skipDangerousModePermissionPrompt": true,
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __HOME__/.claude/hooks/md_write_guard.py",
            "timeout": 10,
            "statusMessage": "Checking this won't clobber your markdown..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "/usr/bin/python3 __HOME__/.claude/hooks/accelerator_guard.py",
            "timeout": 30,
            "statusMessage": "Checking for GPUs and TPUs still running..."
          }
        ]
      }
    ]
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeCoAuthoredBy": false,
  "cleanupPeriodDays": 3650,
  "promptCacheTtl": "1h",
  "model": "claude-opus-5-5[1m]",
  "effortLevel": "xhigh",
  "enabledPlugins": {
    "superpowers@claude-plugins-official": true
  },
  "extraKnownMarketplaces": {
    "claude-plugins-official": {
      "source": {
        "source": "github",
        "repo": "anthropics/claude-plugins-official"
      }
    }
  },
  "env": {
    "CLAUDE_CODE_USE_VERTEX": "1",
    "ANTHROPIC_VERTEX_PROJECT_ID": "__PROJECT_ID__",
    "CLOUD_ML_REGION": "__REGION__",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-opus-5-5[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5-5[1m]",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5-5[1m]",
    "CLAUDE_STREAM_IDLE_TIMEOUT_MS": "1800000"
  }
}
