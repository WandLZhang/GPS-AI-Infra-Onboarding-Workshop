# claude-smoke-test: check that Claude Code can use the three tools the workshop relies on.
#
#   1. docs     The Google developer knowledge MCP answers a docs question.
#   2. pricing  The gcp-pricing CLI pulls a live price.
#   3. logging  The Cloud Logging MCP reads back a log entry this script writes.
#
# Usage: claude-smoke-test [PROJECT_ID]
#
# Each check reads Claude's tool calls from its stream-json output, so a check passes only
# when Claude used that tool, not when it answered from memory. Three short requests at low
# effort; the script prints what each one cost.
set -uo pipefail
# gcloud asks "enable and retry? (y/N)" when an API is off, then waits on stdin forever.
export CLOUDSDK_CORE_DISABLE_PROMPTS=1

PROJECT="${1:-${ANTHROPIC_VERTEX_PROJECT_ID:-$(gcloud config get-value project 2>/dev/null)}}"
if [ -z "$PROJECT" ]; then
    echo "usage: claude-smoke-test <PROJECT_ID>"
    exit 1
fi
if ! command -v claude >/dev/null; then
    echo "claude isn't on PATH. Open a new terminal, or run: source ~/.bashrc"
    exit 1
fi

WORK="$(mktemp -d)"
trap 'rm -rf "$WORK"' EXIT
MARKER="smoke-$(whoami)-$(date +%s)"

echo "Smoke test in project $PROJECT"
if gcloud logging write claude-smoke-test "$MARKER" --project="$PROJECT" >/dev/null 2>"$WORK/logwrite.err"; then
    echo "  wrote log entry $MARKER to logs/claude-smoke-test"
else
    echo "  couldn't write a log entry, so the logging check will fail:"
    sed 's/^/    /' "$WORK/logwrite.err"
    echo "    You need roles/logging.logWriter on $PROJECT."
fi

# disableAllHooks keeps the Stop hook from adding a second, paid turn to each request.
ask() {
    timeout 300 claude -p --effort low --no-session-persistence \
        --settings '{"disableAllHooks":true}' \
        --output-format stream-json --verbose "$2" \
        > "$WORK/$1.jsonl" 2> "$WORK/$1.err" < /dev/null
}

ask docs "Use the google-dev-knowledge MCP, not a web search, to answer in two sentences: which GPU machine types support the Dynamic Workload Scheduler flex-start provisioning model? End with the URL of the page you used."
ask pricing "Run this command in Bash and nothing else: gcp-pricing tpu --filter Trillium. From its output, reply with one region and its on-demand price per chip-hour, as printed."
ask logging "Use the google-cloud-logging MCP, not gcloud, to find the newest log entry in project $PROJECT whose logName is projects/$PROJECT/logs/claude-smoke-test. Reply with its text payload and its timestamp."

python3 - "$WORK" "$MARKER" <<'PY'
import json
import os
import sys

work, marker = sys.argv[1], sys.argv[2]


def read(name):
    """Return the tool calls, the final text, whether it errored, and the cost of one run."""
    calls, result, is_error, cost = [], "", True, 0.0
    path = os.path.join(work, name + ".jsonl")
    if not os.path.exists(path):
        return calls, result, is_error, cost
    with open(path) as f:
        for line in f:
            try:
                event = json.loads(line)
            except ValueError:
                continue
            if event.get("type") == "assistant":
                for block in event.get("message", {}).get("content", []):
                    if block.get("type") == "tool_use":
                        calls.append((block.get("name", ""), block.get("input", {})))
            elif event.get("type") == "result":
                result = event.get("result") or ""
                is_error = bool(event.get("is_error"))
                cost = float(event.get("total_cost_usd") or 0)
    return calls, result, is_error, cost


checks = {
    "docs": (
        lambda calls, text: any(n.startswith("mcp__google-dev-knowledge__") for n, _ in calls)
        and "cloud.google.com" in text,
        "the google-dev-knowledge MCP and a docs URL in the answer",
    ),
    "pricing": (
        lambda calls, text: any(n == "Bash" and "gcp-pricing" in str(i.get("command", "")) for n, i in calls)
        and "$" in text,
        "a Bash call to gcp-pricing and a dollar price in the answer",
    ),
    "logging": (
        lambda calls, text: any(n.startswith("mcp__google-cloud-logging__") for n, _ in calls)
        and marker in text,
        f"the google-cloud-logging MCP and the marker {marker} in the answer",
    ),
}

failed, total = 0, 0.0
for name, (passed, wanted) in checks.items():
    calls, text, is_error, cost = read(name)
    total += cost
    tools = ", ".join(sorted({n for n, _ in calls})) or "none"
    if not is_error and passed(calls, text):
        print(f"  {name:8} ok    (${cost:.2f}; tools: {tools})")
        continue
    failed += 1
    print(f"  {name:8} FAIL  (${cost:.2f}; tools: {tools})")
    print(f"           wanted {wanted}")
    answer = " ".join(text.split()) or "(no answer)"
    print(f"           answer: {answer}")
    err = os.path.join(work, name + ".err")
    if os.path.exists(err) and os.path.getsize(err):
        with open(err) as f:
            print("           stderr: " + " ".join(f.read().split()))

print(f"  total cost ${total:.2f}")
if failed:
    print(f"  {failed} of 3 checks failed. See 'If a check fails' in 1-setup/README.md.")
    sys.exit(1)
print("  All 3 checks passed. Claude Code can read the docs, price a machine and read your logs.")
PY
