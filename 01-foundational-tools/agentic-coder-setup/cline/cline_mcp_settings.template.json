{
  "mcpServers": {
    "github.com/cline/cline-community": {
      "autoApprove": ["preview_cline_issue"],
      "disabled": false,
      "timeout": 10,
      "type": "stdio",
      "command": "node",
      "args": ["<MCP_DIR>/cline-community/build/index.js"],
      "env": {
        "GH_TOKEN": "<GH_TOKEN>"
      },
      "_install": "git clone https://github.com/cline/cline-community.git <MCP_DIR>/cline-community && cd <MCP_DIR>/cline-community && npm install && npm run build"
    },
    "google-dev-knowledge": {
      "autoApprove": ["search_documents", "get_documents", "get_document", "batch_get_documents", "answer_query"],
      "disabled": false,
      "timeout": 30,
      "type": "stdio",
      "command": "node",
      "args": ["<MCP_DIR>/google-dev-knowledge/proxy.mjs"],
      "env": {
        "GOOGLE_DEV_KNOWLEDGE_API_KEY": "<GOOGLE_DEV_KNOWLEDGE_API_KEY>"
      },
      "_install": "Copy mcp-servers/google-dev-knowledge/proxy.mjs to <MCP_DIR>/google-dev-knowledge/proxy.mjs"
    },
    "google-cloud-logging": {
      "autoApprove": ["list_log_entries", "list_log_names", "list_buckets", "list_views", "get_bucket", "get_view"],
      "disabled": false,
      "timeout": 30,
      "command": "node",
      "args": ["<MCP_DIR>/google-cloud-logging/proxy.mjs"],
      "transportType": "stdio",
      "_install": "Copy mcp-servers/google-cloud-logging/proxy.mjs to <MCP_DIR>/google-cloud-logging/proxy.mjs. No API key needed — uses gcloud auth."
    },
    "github.com/github/github-mcp-server": {
      "autoApprove": [
        "get_file_contents",
        "get_commit",
        "get_me",
        "get_tag",
        "get_label",
        "get_latest_release",
        "get_release_by_tag",
        "get_team_members",
        "get_teams",
        "list_branches",
        "list_commits",
        "list_issues",
        "list_pull_requests",
        "list_releases",
        "list_tags",
        "list_issue_types",
        "search_code",
        "search_issues",
        "search_pull_requests",
        "search_repositories",
        "search_users",
        "issue_read",
        "pull_request_read"
      ],
      "disabled": false,
      "timeout": 30,
      "type": "stdio",
      "command": "<MCP_DIR>/github-mcp-server/github-mcp-server",
      "args": ["stdio"],
      "env": {
        "GITHUB_PERSONAL_ACCESS_TOKEN": "<GH_TOKEN>"
      },
      "_install": "Download latest from https://github.com/github/github-mcp-server/releases (github-mcp-server_Linux_x86_64.tar.gz), extract to <MCP_DIR>/github-mcp-server/, chmod +x"
    },
    "huggingface": {
      "autoApprove": [
        "hf_whoami",
        "hf_doc_search",
        "hf_doc_fetch",
        "hub_repo_search",
        "hub_repo_details",
        "paper_search",
        "space_search",
        "hf_hub_query"
      ],
      "disabled": false,
      "timeout": 60,
      "type": "streamableHttp",
      "url": "https://huggingface.co/mcp",
      "headers": {
        "Authorization": "Bearer <HF_TOKEN>"
      },
      "_install": "No install needed — native streamable HTTP transport (no npx mcp-remote subprocess bridge to leak/orphan)"
    },
    "google-cloud-storage": {
      "autoApprove": [
        "list_buckets",
        "list_objects",
        "list_insights_configs",
        "get_bucket_metadata",
        "get_bucket_location",
        "get_metadata_table_schema",
        "read_object_content",
        "read_object_metadata",
        "view_iam_policy",
        "check_iam_permissions"
      ],
      "disabled": false,
      "timeout": 30,
      "type": "stdio",
      "command": "npx",
      "args": ["-y", "@google-cloud/storage-mcp"],
      "_install": "No install needed — uses npx @google-cloud/storage-mcp at runtime. Auth via gcloud ADC."
    }
  }
}
