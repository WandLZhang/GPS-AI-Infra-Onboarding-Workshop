# Launch wrapper for the Claude Code VS Code extension — pins effort to max.
#
# Why this exists: settings.json `effortLevel` accepts low|medium|high|xhigh only.
# "max" fails that enum, the loader drops it, and the session falls back to the
# model default, high. Only the --effort CLI flag takes max.
#
# The extension spawns this as:  claude-vscode-wrapper <claude-binary> <args...>
# (resolveClaudeBinary puts the real binary in executableArgs, so it is prepended
# to the argument list.) Wire it up with claudeCode.claudeProcessWrapper.
#
# Any --effort the extension already passes is dropped, then max is appended.

set -eo pipefail

bin="$1"
shift

args=()
skip=0
for a in "$@"; do
    if [ "$skip" = 1 ]; then
        skip=0
        continue
    fi
    case "$a" in
        --effort)   skip=1; continue ;;
        --effort=*) continue ;;
    esac
    args+=("$a")
done

exec "$bin" ${args[@]+"${args[@]}"} --effort max
