# Launch wrapper for the Claude Code VS Code extension: max effort by default.
#
# settings.json `effortLevel` takes low|medium|high|xhigh only, so "max" can't be saved
# there, and only the --effort flag reaches it. This wrapper adds --effort max when
# nothing else has chosen an effort:
#   - an --effort the extension passes (your pick in its effort menu) is kept;
#   - a pick saved in ~/.claude/settings.json (top-level effortLevel, or
#     modelSettings.<model>.effortLevel for the configured model) is left to the CLI.
# `/effort auto` clears a saved pick, so the next launch is back at max.
#
# The extension spawns this as:  claude-vscode-wrapper <claude-binary> <args...>
# Wire it up with claudeCode.claudeProcessWrapper.

set -eo pipefail

bin="$1"
shift

for a in "$@"; do
    case "$a" in
        --effort|--effort=*) exec "$bin" "$@" ;;
    esac
done

saved=$(python3 - <<'PY' 2>/dev/null || true
import json, os
try:
    s = json.load(open(os.path.expanduser("~/.claude/settings.json")))
except Exception:
    raise SystemExit
if s.get("effortLevel"):
    print(s["effortLevel"])
    raise SystemExit
model = str(s.get("model") or "").split("[")[0].lower()
for name, cfg in (s.get("modelSettings") or {}).items():
    if model and model in name.lower() and isinstance(cfg, dict) and cfg.get("effortLevel"):
        print(cfg["effortLevel"])
        break
PY
)

if [ -n "$saved" ]; then
    exec "$bin" "$@"
fi
exec "$bin" "$@" --effort max
