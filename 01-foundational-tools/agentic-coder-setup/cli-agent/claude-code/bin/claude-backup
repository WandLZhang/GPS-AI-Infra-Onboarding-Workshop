# Copy Claude Code's conversations and memory to a Cloud Storage bucket you own.
#
#   claude-backup gs://YOUR_BUCKET            copy now
#   claude-backup gs://YOUR_BUCKET --dry-run  list what would be copied
#
# CLAUDE_BACKUP_BUCKET can stand in for the first argument.
#
# Copies ~/.claude/projects (every transcript, plus the memory folders),
# ~/.claude/history.jsonl, ~/.claude/CLAUDE.md and ~/.claude/settings.json to
# gs://YOUR_BUCKET/<hostname>/. Nothing is deleted from the bucket, so a
# conversation deleted on the machine keeps its copy there.
#
# To restore on a new machine with the same username:
#   gcloud storage rsync -r gs://YOUR_BUCKET/<old-hostname>/projects ~/.claude/projects
set -uo pipefail

BUCKET="${CLAUDE_BACKUP_BUCKET:-}"
DRY=()
for a in "$@"; do
    case "$a" in
        --dry-run) DRY=(--dry-run) ;;
        gs://*) BUCKET="$a" ;;
        *) echo "usage: claude-backup gs://YOUR_BUCKET [--dry-run]" >&2; exit 2 ;;
    esac
done
[ -n "$BUCKET" ] || { echo "usage: claude-backup gs://YOUR_BUCKET [--dry-run]" >&2; exit 2; }
DEST="${BUCKET%/}/$(hostname)"

echo "=== $(date -Is) claude-backup to $DEST ${DRY[*]}"
gcloud storage rsync -r "${DRY[@]}" "$HOME/.claude/projects" "$DEST/projects" \
    || { echo "transcript copy failed" >&2; exit 1; }
for f in history.jsonl CLAUDE.md settings.json; do
    [ -f "$HOME/.claude/$f" ] || continue
    if [ ${#DRY[@]} -gt 0 ]; then
        echo "would copy ~/.claude/$f to $DEST/_meta/$f"
    else
        gcloud storage cp "$HOME/.claude/$f" "$DEST/_meta/$f" || echo "$f copy failed" >&2
    fi
done
echo "=== done"
