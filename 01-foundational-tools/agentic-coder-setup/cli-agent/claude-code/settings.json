{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "WebFetch",
      "WebSearch",

      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(find *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(echo *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(file *)",
      "Bash(tree *)",
      "Bash(env)",
      "Bash(date)",
      "Bash(whoami)",
      "Bash(hostname)",
      "Bash(uname *)",
      "Bash(df *)",
      "Bash(du *)",
      "Bash(free *)",
      "Bash(ps *)",
      "Bash(id)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(realpath *)",
      "Bash(basename *)",
      "Bash(dirname *)",
      "Bash(sort *)",
      "Bash(uniq *)",
      "Bash(cut *)",
      "Bash(tr *)",
      "Bash(jq *)",
      "Bash(md5sum *)",
      "Bash(sha256sum *)",

      "mcp__github-mcp__get_*",
      "mcp__github-mcp__list_*",
      "mcp__github-mcp__search_*",
      "mcp__github-mcp__pull_request_read",
      "mcp__github-mcp__issue_read",
      "mcp__github-mcp__get_me",
      "mcp__google-dev-knowledge__search_documents",
      "mcp__google-dev-knowledge__get_document",
      "mcp__google-dev-knowledge__batch_get_documents",
      "mcp__google-cloud-logging__list_*",
      "mcp__google-cloud-logging__get_*"
    ],
    "deny": []
  },
  "model": "claude-opus-4-7[1m]",
  "effortLevel": "max",
  "env": {
    "CLAUDE_CODE_USE_VERTEX": "1",
    "CLOUD_ML_REGION": "global",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-opus-4-7[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-4-7[1m]"
  }
}
