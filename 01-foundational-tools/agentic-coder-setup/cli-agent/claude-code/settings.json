{
  "permissions": {
    "allow": [
      "Read",
      "Glob",
      "Grep",

      "Bash(cat *)",
      "Bash(ls *)",
      "Bash(head *)",
      "Bash(tail *)",
      "Bash(wc *)",
      "Bash(grep *)",
      "Bash(find *)",
      "Bash(tree *)",
      "Bash(file *)",
      "Bash(diff *)",
      "Bash(stat *)",
      "Bash(pwd)",
      "Bash(which *)",
      "Bash(echo *)",
      "Bash(env)",
      "Bash(date)",
      "Bash(whoami)",

      "mcp__github-mcp__get_*",
      "mcp__github-mcp__list_*",
      "mcp__github-mcp__search_*",
      "mcp__github-mcp__pull_request_read",
      "mcp__github-mcp__issue_read",
      "mcp__github-mcp__get_me",
      "mcp__google-dev-knowledge__search_documents",
      "mcp__google-dev-knowledge__get_document",
      "mcp__google-dev-knowledge__batch_get_documents",
      "mcp__google-cloud-logging__list_*",
      "mcp__google-cloud-logging__get_*"
    ],
    "deny": []
  },
  "model": "claude-opus-5[1m]",
  "effortLevel": "max",
  "env": {
    "CLAUDE_CODE_USE_VERTEX": "1",
    "CLOUD_ML_REGION": "global",
    "ANTHROPIC_SMALL_FAST_MODEL": "claude-opus-5[1m]",
    "CLAUDE_CODE_SUBAGENT_MODEL": "claude-opus-5[1m]"
  }
}
